programa
{    
   	funcao inicio()
	{
		inteiro anoNasc, idade
		
		escreva("Digite o ano do seu nascimento: ")
		leia(anoNasc)
		idade = 2026 - anoNasc
		escreva("Sua idade é: ", idade)
		
	}
}
