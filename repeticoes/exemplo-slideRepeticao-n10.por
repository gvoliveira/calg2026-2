programa
{
	//Faça um algoritmo que imprima na tela os números de 1 a 100
	
	funcao inicio()
	{
		inteiro valor = 1
		faca{
			escreva(valor, " ")
			valor++ // é o mesmo que valor = valor + 1
		}enquanto(valor > 0 e valor <= 100)
	}
}
